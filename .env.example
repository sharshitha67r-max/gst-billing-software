# This is a template. Configure actual values privately in your host settings.
APP_ENV=production
DB_BACKEND=turso
# Create a libSQL database in Turso's free plan and set its private connection.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local-only alternative: DB_BACKEND=sqlite with both Turso variables unset.
DATA_DIR=/app/data
PORT=8000
PUBLIC_URL=https://your-app.example.com
OWNER_EMAIL=owner@example.com
# Supply a strong password of at least 12 characters as a hosting secret.
# It is read only when the database has no owner account yet.
OWNER_PASSWORD=
